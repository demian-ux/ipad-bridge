# claves privadas y certificados emitidos para esta PC (make_certs.py los regenera)
ipad-bridge/certs/*.key
ipad-bridge/certs/*.csr
ipad-bridge/certs/*.srl
ipad-bridge/certs/server.crt
# logs y caches
*.log
*.err
__pycache__/
*.pyc
# paquete distribuible generado
/ipad-bridge.zip
# instalador: descargas, carpeta armada y salida de Inno Setup (installer/build.ps1 los regenera)
ipad-bridge/installer/vendor/
ipad-bridge/installer/payload/
ipad-bridge/installer/dist/
# configuración local de Claude
.claude/settings.local.json
