# claves privadas y certificados emitidos para esta PC (make_certs.py los regenera)
ipad-bridge/certs/*.key
ipad-bridge/certs/*.csr
ipad-bridge/certs/*.srl
ipad-bridge/certs/server.crt
# logs y caches
*.log
*.err
__pycache__/
*.pyc
# paquete distribuible generado
/ipad-bridge.zip
# configuración local de Claude
.claude/settings.local.json
# tokens de emparejamiento (hasheados) e id de la PC
ipad-bridge/certs/pairing.json
# descargas y salida del instalador
ipad-bridge/installer/build/
ipad-bridge/installer/out/
